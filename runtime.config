# Konfiguracja uruchomienia form2json (format INI).
# Uruchomienie bez parametrów (wszystko bierze się z tego pliku):
#     python form2json\run.py                 (z katalogu Formularze-Wypakowane)
#     python -m form2json                     (to samo, jako moduł)
# Parametry z linii poleceń (np. -o, --no-vlm, --fast) nadpisują wartości z tego pliku.
# Ścieżki względne liczone są względem katalogu, w którym leży ten plik.

[paths]
# katalog (lub pojedynczy plik) z formularzami do rozpoznania; kilka ścieżek rozdziel znakiem ;
input = C:\Hackathon2026\test-kilku-plikow
# katalog na wyniki (*.simple.json, *.fields.json, *.form.json, RAPORT.md)
output = C:\Hackathon2026\test-kilku-plikow\output

[model]
# true  = lokalny VLM na GPU (Ollama); false = tylko geometria + OCR na CPU (szybko, gorsze etykiety)
vlm_enabled = true
# który model użyć: default | fast | accurate
profile = default
# model domyślny - ten, którym wygenerowano wyniki konkursowe (~6 GB VRAM, ~6-10 s/strona)
default_model = qwen3-vl:8b-instruct
# prostszy, szybszy model (~3 GB VRAM); przed użyciem:  ollama pull qwen3-vl:4b-instruct
fast_model = qwen3-vl:4b-instruct
# większy model MoE (~20 GB VRAM), wolniejszy
accurate_model = qwen3-vl:30b-a3b-instruct

[processing]
# auto | tesseract | paddle | paddle-cpu | none   (OCR dla obrazów i skanów)
ocr = auto
# auto | single   (podział FormDefinition na strony)
tabs = auto
dpi = 150
# true = zapis podglądu wykrytych pól (*.debug.png)
debug = false

[report]
# true = po rozpoznaniu wygeneruj <output>\RAPORT.md (walidacja, recall vs referencja, spójność formatów)
enabled = true
# gdzie szukać plików referencyjnych konfiguracja_form_*.json (puste = katalog input)
ref_dir = C:\Hackathon2026\Formularze-Wypakowane

[timing]
# true = czas każdego pliku i łączny w jednej linii + podsumowanie na końcu
enabled = true
