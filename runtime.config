# form2json - konfiguracja uruchomienia (INI). Start: python form2json\run.py  albo  python -m form2json
# Parametry z linii poleceń mają pierwszeństwo. Ścieżki względne liczone od katalogu tego pliku.

[paths]
# formularze do rozpoznania: katalog lub plik, kilka rozdziel ;
input = C:\Hackathon2026\test-kilku-plikow
output = C:\Hackathon2026\test-kilku-plikow\output

[model]
# false = bez VLM, tylko geometria + OCR na CPU (szybko, gorsze etykiety pól)
vlm_enabled = true
# default | fast | accurate
profile = default
# domyślny, najlepszy stosunek jakości do czasu (~6 GB VRAM)
default_model = qwen3-vl:8b-instruct
# ~15% szybszy, ale wyraźnie gorszy (recall 62-85% zamiast 91%)
fast_model = qwen3-vl:4b-instruct
# MoE, ~20 GB VRAM, wolniejszy
accurate_model = qwen3-vl:30b-a3b-instruct

[performance]
# Ile pracy naraz. 1 = po kolei. Zmierzone na RTX 4090: 4 / 2 / 4 = ~3x szybciej, ta sama dokładność.
# plików naraz: LibreOffice/OCR (CPU) jednego pliku działa w czasie, gdy GPU liczy inny
file_workers = 2
# stron jednego pliku wysyłanych naraz do VLM
vlm_parallel = 4
# ile zapytań serwer Ollama liczy jednocześnie (wsadowo na GPU); każde dodatkowe zajmuje VRAM na kontekst.
# Zapytania ponad ten limit czekają w kolejce. Zalecane = vlm_parallel.
server_parallel = 4

[processing]
# OCR obrazów i skanów: auto | tesseract | paddle | paddle-cpu | none
ocr = auto
# podział FormDefinition na strony: auto | single
tabs = auto
dpi = 150
# true = podgląd wykrytych pól (*.debug.png)
debug = false

[report]
# RAPORT.md w katalogu wyników: walidacja, recall względem referencji, spójność formatów, czasy
enabled = true
# gdzie szukać referencji konfiguracja_form_*.json (puste = katalog input)
ref_dir = C:\Hackathon2026\Formularze-Wypakowane

[timing]
# czas pliku i czas łączny w linii każdego pliku + podsumowanie na końcu
enabled = true

[ollama]
# auto   = przy lokalnym adresie form2json sam uruchamia `ollama serve` z ustawieniami poniżej
#          i zamyka go po pracy (bez zmiennych systemowych, tak samo na każdym OS);
#          adres nielokalny (Docker: http://ollama:11434) zostaje bez zmian
# always = zawsze własny serwer;  never = zawsze serwer z config/local.toml
manage = auto
port = 11435
flash_attention = true
# jak długo model zostaje w VRAM po ostatnim zapytaniu
keep_alive = 30m
# pobierz brakujący model automatycznie (jednorazowo, ~6 GB)
auto_pull = true
